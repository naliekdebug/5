//@version=5
// =====================================================================
//  Stop-Loss Liquidity Map & Trade Planner
//  -------------------------------------------------------------------
//  Analyzes the chart for where stop-loss orders most likely rest
//  (resting liquidity), clusters them into weighted "stop pools", then
//  plans an Entry / Stop / Take-Profit around those levels.
//
//  Core idea: stops cluster JUST BEYOND protective levels —
//    • below swing lows  (longs' stops  = sell-side liquidity)
//    • above swing highs (shorts' stops = buy-side  liquidity)
//    • at equal highs/lows, prior day/week extremes, round numbers
//  Price is drawn toward these pools; so we place OUR stop BEYOND a
//  pool (survive the sweep) and TARGET the opposite pool.
//
//  Scalable to ANY asset / timeframe: every tolerance is ATR- or
//  percent-based (no hardcoded pips/ticks).
//
//  NOTE: analysis/visualization tool, not financial advice. The plan is
//  a structured suggestion — validate it with your own context.
// =====================================================================
indicator("Stop-Loss Liquidity Map & Trade Planner", overlay=true,
     max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ---------------------------------------------------------------------
// INPUTS
// ---------------------------------------------------------------------
gGen = "── General ──"
atrLen   = input.int(14, "ATR length (scaling)", minval=1, group=gGen)
swingLen = input.int(8, "Swing lookback (pivots)", minval=2, maxval=50, group=gGen, tooltip="Bars each side to confirm a swing high/low.")

gPool = "── Stop-Loss Pool Detection ──"
stopBufATR  = input.float(0.10, "Stop sits beyond level (× ATR)", minval=0.0, step=0.05, group=gPool, tooltip="How far past a swing the crowd's stops typically rest.")
clusterATR  = input.float(0.30, "Cluster merge tolerance (× ATR)", minval=0.05, step=0.05, group=gPool, tooltip="Candidate levels within this distance merge into one pool (strength adds up).")
useEqual    = input.bool(true, "Extra weight for Equal Highs/Lows", group=gPool)
eqTolATR    = input.float(0.10, "Equal H/L tolerance (× ATR)", minval=0.0, step=0.05, group=gPool)
usePrevDay  = input.bool(true, "Include prev day High/Low", group=gPool)
usePrevWeek = input.bool(true, "Include prev week High/Low", group=gPool)
roundStep   = input.float(0.0, "Round-number step (0 = off)", minval=0.0, step=0.0001, group=gPool, tooltip="e.g. 1.0 for indices, 0.0010 for FX, 100 for BTC. Adds psychological levels.")
maxPools    = input.int(24, "Max pools kept", minval=4, maxval=60, group=gPool)
minStrShow  = input.float(1.0, "Min strength to display", minval=0.0, step=0.5, group=gPool)
poolExtend  = input.int(25, "Pool line extend (bars)", minval=1, maxval=500, group=gPool)

gPlan = "── Trade Planner ──"
showPlan    = input.bool(true, "Show trade plan", group=gPlan)
biasMode    = input.string("Auto", "Directional bias", options=["Auto","Long","Short"], group=gPlan)
emaLen      = input.int(50, "Bias EMA (Auto mode)", minval=2, group=gPlan)
entryMode   = input.string("Market (current price)", "Entry", options=["Market (current price)","Limit at pullback pool"], group=gPlan)
slBufATR    = input.float(0.25, "Stop beyond pool (× ATR)", minval=0.0, step=0.05, group=gPlan, tooltip="Extra cushion placed past the protective pool so a sweep doesn't tag you.")
minStrPlan  = input.float(2.0, "Min pool strength for plan", minval=0.0, step=0.5, group=gPlan, tooltip="Plan prefers clustered/confluent pools over single swings.")
rrFallback  = input.float(2.0, "Fallback R:R (no pool target)", minval=0.5, step=0.5, group=gPlan)
planExtend  = input.int(40, "Plan line extend (bars)", minval=1, maxval=500, group=gPlan)

gSize = "── Position Sizing ──"
acctSize  = input.float(10000, "Account size ($)", minval=0, group=gSize)
riskPct   = input.float(1.0, "Risk per trade (%)", minval=0.0, step=0.25, group=gSize)
pointVal  = input.float(1.0, "$ per 1.0 price move / unit", minval=0.0, step=0.1, group=gSize, tooltip="Contract/lot value per full price point. 1 = generic.")

gAlert = "── Alerts ──"
alertATR = input.float(0.25, "Alert when price within (× ATR) of pool", minval=0.0, step=0.05, group=gAlert)

gCol = "── Colors ──"
colAbove = input.color(color.new(color.red, 0),  "Buy-side pool (above)",  group=gCol, inline="c1")
colBelow = input.color(color.new(color.green, 0),"Sell-side pool (below)", group=gCol, inline="c1")
colEntry = input.color(color.new(color.blue, 0),  "Entry", group=gCol, inline="c2")
colSL    = input.color(color.new(color.red, 0),   "Stop",  group=gCol, inline="c2")
colTP    = input.color(color.new(color.green, 0), "Target",group=gCol, inline="c2")

// ---------------------------------------------------------------------
// CORE CALCS
// ---------------------------------------------------------------------
atr = ta.atr(atrLen)
ph  = ta.pivothigh(high, swingLen, swingLen)
pl  = ta.pivotlow(low, swingLen, swingLen)
emaVal = ta.ema(close, emaLen)

var float prevPH = na
var float prevPL = na

// ---------------------------------------------------------------------
// POOL MODEL
// ---------------------------------------------------------------------
type Pool
    float price
    float strength
    bool  above      // true = buy-side (above swing high), false = sell-side
    int   bornBar
    bool  eq         // contains equal high/low
    bool  htf        // contains prev day/week level
    bool  rnd        // contains round number
    line  ln
    label lb

var array<Pool> pools = array.new<Pool>()

createPool(float price, float strength, bool above, int bornBar, bool eq, bool htf, bool rnd) =>
    col = above ? colAbove : colBelow
    ln = line.new(bornBar, price, bar_index + poolExtend, price, color=color.new(col, 55), width=1)
    lb = label.new(bar_index + poolExtend, price, "", style=label.style_label_left,
         color=color.new(col, 100), textcolor=col, size=size.tiny)
    array.push(pools, Pool.new(price, strength, above, bornBar, eq, htf, rnd, ln, lb))

// Merge a swing-derived level into a nearby pool (strength accumulates),
// or create a new pool. This is what makes confluent levels "strong".
addSwing(float lvl, bool above, float w, int bornBar, bool eq) =>
    tol = clusterATR * atr
    merged = false
    if array.size(pools) > 0
        for i = 0 to array.size(pools) - 1
            p = array.get(pools, i)
            if p.above == above and math.abs(p.price - lvl) <= tol
                p.price    := (p.price * p.strength + lvl * w) / (p.strength + w)
                p.strength := p.strength + w
                p.eq       := p.eq or eq
                merged     := true
                break
    if not merged
        createPool(lvl, w, above, bornBar, eq, false, false)

// Add a STATIC level (prev day/week, round number) without inflating
// strength on every bar: skip if one already exists at ~the same price.
addStatic(float lvl, float w, bool htf, bool rnd) =>
    tol = math.max(clusterATR * atr * 0.5, syminfo.mintick)
    exists = false
    above = lvl > close
    if array.size(pools) > 0
        for i = 0 to array.size(pools) - 1
            p = array.get(pools, i)
            if math.abs(p.price - lvl) <= tol
                p.htf := p.htf or htf
                p.rnd := p.rnd or rnd
                exists := true
                break
    if not exists
        createPool(lvl, w, above, bar_index, false, htf, rnd)

// ---------------------------------------------------------------------
// FEED CANDIDATE STOP LEVELS
// ---------------------------------------------------------------------
// Swings → stops rest just BEYOND them.
if not na(ph)
    isEq = useEqual and not na(prevPH) and math.abs(ph - prevPH) <= eqTolATR * atr
    w = isEq ? 2.0 : 1.0
    addSwing(ph + stopBufATR * atr, true, w, bar_index - swingLen, isEq)
    prevPH := ph
if not na(pl)
    isEq = useEqual and not na(prevPL) and math.abs(pl - prevPL) <= eqTolATR * atr
    w = isEq ? 2.0 : 1.0
    addSwing(pl - stopBufATR * atr, false, w, bar_index - swingLen, isEq)
    prevPL := pl

// Prev day / week extremes (no repaint: previous completed period).
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead=barmerge.lookahead_on)
if usePrevDay and not na(pdh) and (na(pdh[1]) or pdh != pdh[1])
    addStatic(pdh + stopBufATR * atr, 2.0, true, false)
    addStatic(pdl - stopBufATR * atr, 2.0, true, false)
if usePrevWeek and not na(pwh) and (na(pwh[1]) or pwh != pwh[1])
    addStatic(pwh + stopBufATR * atr, 2.5, true, false)
    addStatic(pwl - stopBufATR * atr, 2.5, true, false)

// Round numbers near price (dedup prevents per-bar inflation).
if roundStep > 0
    base = math.round(close / roundStep) * roundStep
    for k = -2 to 2
        addStatic(base + k * roundStep, 1.0, false, true)

// Trim weakest pools to cap object count.
while array.size(pools) > maxPools
    wi = 0
    ws = 1.0e18
    for i = 0 to array.size(pools) - 1
        p = array.get(pools, i)
        if p.strength < ws
            ws := p.strength
            wi := i
    pp = array.get(pools, wi)
    pp.ln.delete()
    pp.lb.delete()
    array.remove(pools, wi)

// ---------------------------------------------------------------------
// NEAREST-POOL HELPERS
// ---------------------------------------------------------------------
f_nearestAbove(float ref, float minStr) =>
    float b1 = na
    if array.size(pools) > 0
        for i = 0 to array.size(pools) - 1
            p = array.get(pools, i)
            if p.strength >= minStr and p.price > ref and (na(b1) or p.price < b1)
                b1 := p.price
    float b2 = na
    if not na(b1) and array.size(pools) > 0
        for i = 0 to array.size(pools) - 1
            p = array.get(pools, i)
            if p.strength >= minStr and p.price > b1 and (na(b2) or p.price < b2)
                b2 := p.price
    [b1, b2]

f_nearestBelow(float ref, float minStr) =>
    float b1 = na
    if array.size(pools) > 0
        for i = 0 to array.size(pools) - 1
            p = array.get(pools, i)
            if p.strength >= minStr and p.price < ref and (na(b1) or p.price > b1)
                b1 := p.price
    float b2 = na
    if not na(b1) and array.size(pools) > 0
        for i = 0 to array.size(pools) - 1
            p = array.get(pools, i)
            if p.strength >= minStr and p.price < b1 and (na(b2) or p.price > b2)
                b2 := p.price
    [b1, b2]

// For alerts (any strength, nearest on each side).
[naAbove, _ua] = f_nearestAbove(close, 0.0)
[naBelow, _ub] = f_nearestBelow(close, 0.0)

// ---------------------------------------------------------------------
// DRAW / REFRESH POOLS (on last bar — final accumulated state)
// ---------------------------------------------------------------------
if barstate.islast and array.size(pools) > 0
    for i = 0 to array.size(pools) - 1
        p = array.get(pools, i)
        visible = p.strength >= minStrShow
        col = p.above ? colAbove : colBelow
        transp = math.max(0, 80 - int(p.strength) * 14)
        p.ln.set_x2(bar_index + poolExtend)
        p.ln.set_color(visible ? color.new(col, transp) : color.new(col, 100))
        p.ln.set_width(visible ? math.min(4, math.max(1, int(math.round(p.strength)))) : 1)
        tag = (p.above ? "▲ buy-side stops" : "▼ sell-side stops")
        tag := tag + "  x" + str.tostring(p.strength, "#.#")
        tag := tag + (p.eq ? " EQ" : "") + (p.htf ? " HTF" : "") + (p.rnd ? " RND" : "")
        p.lb.set_x(bar_index + poolExtend)
        p.lb.set_y(p.price)
        p.lb.set_text(visible ? tag : "")
        p.lb.set_textcolor(visible ? col : color.new(col, 100))

// ---------------------------------------------------------------------
// TRADE PLAN
// ---------------------------------------------------------------------
var line   lnEntry = na
var line   lnSL    = na
var line   lnTP1   = na
var line   lnTP2   = na
var box    boxRisk = na
var box    boxRwd  = na
var label  lblE    = na
var label  lblS    = na
var label  lblT1   = na
var label  lblT2   = na
var table  tbl     = table.new(position.top_right, 2, 9, border_width=1)

if barstate.islast and showPlan
    // clear previous plan drawings (re-runs every realtime tick on last bar)
    line.delete(lnEntry)
    line.delete(lnSL)
    line.delete(lnTP1)
    line.delete(lnTP2)
    box.delete(boxRisk)
    box.delete(boxRwd)
    label.delete(lblE)
    label.delete(lblS)
    label.delete(lblT1)
    label.delete(lblT2)

    price = close
    biasLong  = biasMode == "Long"  or (biasMode == "Auto" and price >= emaVal)
    biasShort = biasMode == "Short" or (biasMode == "Auto" and price <  emaVal)

    [abv1, abv2] = f_nearestAbove(price, minStrPlan)
    [bel1, bel2] = f_nearestBelow(price, minStrPlan)

    float entry = na
    float sl    = na
    float tp1   = na
    float tp2   = na
    string note = ""
    bool ok = true

    if biasLong
        if entryMode == "Market (current price)"
            entry := price
            sl    := not na(bel1) ? bel1 - slBufATR * atr : price - rrFallback * atr
        else
            entry := not na(bel1) ? bel1 : price
            sl    := not na(bel2) ? bel2 - slBufATR * atr : (not na(bel1) ? bel1 - (slBufATR + stopBufATR) * atr : price - rrFallback * atr)
        r0 = math.abs(entry - sl)
        tp1 := not na(abv1) ? abv1 : entry + rrFallback * r0
        tp2 := not na(abv2) ? abv2 : entry + 2.0 * rrFallback * r0
        note := not na(abv1) ? "Target: buy-side pool(s) above" : "No pool above — fallback R:R target"
    else if biasShort
        if entryMode == "Market (current price)"
            entry := price
            sl    := not na(abv1) ? abv1 + slBufATR * atr : price + rrFallback * atr
        else
            entry := not na(abv1) ? abv1 : price
            sl    := not na(abv2) ? abv2 + slBufATR * atr : (not na(abv1) ? abv1 + (slBufATR + stopBufATR) * atr : price + rrFallback * atr)
        r0 = math.abs(entry - sl)
        tp1 := not na(bel1) ? bel1 : entry - rrFallback * r0
        tp2 := not na(bel2) ? bel2 : entry - 2.0 * rrFallback * r0
        note := not na(bel1) ? "Target: sell-side pool(s) below" : "No pool below — fallback R:R target"
    else
        ok := false

    float risk = na
    float rr1  = na
    float rr2  = na
    float qty  = na
    if ok
        risk := math.abs(entry - sl)
        if risk > 0
            rr1 := math.abs(tp1 - entry) / risk
            rr2 := math.abs(tp2 - entry) / risk
            riskMoney = acctSize * riskPct / 100.0
            qty := (pointVal > 0) ? riskMoney / (risk * pointVal) : na

    // ---- draw lines + zones ----
    if ok and risk > 0
        xL = bar_index - 5
        xR = bar_index + planExtend
        lnEntry := line.new(xL, entry, xR, entry, color=colEntry, width=2)
        lnSL    := line.new(xL, sl,  xR, sl,  color=colSL,  width=2, style=line.style_dashed)
        lnTP1   := line.new(xL, tp1, xR, tp1, color=colTP,  width=2)
        lnTP2   := line.new(xL, tp2, xR, tp2, color=color.new(colTP, 40), width=1, style=line.style_dotted)
        boxRisk := box.new(bar_index, math.max(entry, sl), xR, math.min(entry, sl), border_width=0, bgcolor=color.new(colSL, 88))
        boxRwd  := box.new(bar_index, math.max(entry, tp1), xR, math.min(entry, tp1), border_width=0, bgcolor=color.new(colTP, 88))
        lblE  := label.new(xR, entry, "Entry "  + str.tostring(entry, format.mintick), style=label.style_label_left, color=color.new(colEntry,20), textcolor=color.white, size=size.small)
        lblS  := label.new(xR, sl,    "SL "     + str.tostring(sl,  format.mintick), style=label.style_label_left, color=color.new(colSL,20),    textcolor=color.white, size=size.small)
        lblT1 := label.new(xR, tp1,   "TP1 "    + str.tostring(tp1, format.mintick) + "  (" + str.tostring(rr1,"#.##") + "R)", style=label.style_label_left, color=color.new(colTP,20), textcolor=color.white, size=size.small)
        lblT2 := label.new(xR, tp2,   "TP2 "    + str.tostring(tp2, format.mintick) + "  (" + str.tostring(rr2,"#.##") + "R)", style=label.style_label_left, color=color.new(colTP,40), textcolor=color.white, size=size.small)

    // ---- summary table ----
    bg = color.new(color.black, 15)
    table.cell(tbl, 0, 0, "TRADE PLAN", text_color=color.white, bgcolor=color.new(color.blue,10), text_size=size.normal)
    table.cell(tbl, 1, 0, ok ? (biasLong ? "LONG ▲" : "SHORT ▼") : "—", text_color=color.white, bgcolor=ok ? (biasLong ? color.new(color.green,10) : color.new(color.red,10)) : color.new(color.gray,10), text_size=size.normal)
    table.cell(tbl, 0, 1, "Entry", text_color=color.white, bgcolor=bg)
    table.cell(tbl, 1, 1, ok ? str.tostring(entry, format.mintick) : "no clean setup", text_color=color.white, bgcolor=bg)
    table.cell(tbl, 0, 2, "Stop Loss", text_color=color.white, bgcolor=bg)
    table.cell(tbl, 1, 2, ok ? str.tostring(sl, format.mintick) : "—", text_color=color.new(colSL,0), bgcolor=bg)
    table.cell(tbl, 0, 3, "TP1", text_color=color.white, bgcolor=bg)
    table.cell(tbl, 1, 3, ok ? (str.tostring(tp1, format.mintick) + "  " + str.tostring(rr1,"#.##") + "R") : "—", text_color=color.new(colTP,0), bgcolor=bg)
    table.cell(tbl, 0, 4, "TP2", text_color=color.white, bgcolor=bg)
    table.cell(tbl, 1, 4, ok ? (str.tostring(tp2, format.mintick) + "  " + str.tostring(rr2,"#.##") + "R") : "—", text_color=color.new(colTP,0), bgcolor=bg)
    table.cell(tbl, 0, 5, "Risk (price)", text_color=color.white, bgcolor=bg)
    table.cell(tbl, 1, 5, ok ? str.tostring(risk, format.mintick) : "—", text_color=color.white, bgcolor=bg)
    table.cell(tbl, 0, 6, "Risk ($)", text_color=color.white, bgcolor=bg)
    table.cell(tbl, 1, 6, str.tostring(acctSize * riskPct / 100.0, "#.##"), text_color=color.white, bgcolor=bg)
    table.cell(tbl, 0, 7, "Suggested size", text_color=color.white, bgcolor=bg)
    table.cell(tbl, 1, 7, (ok and not na(qty)) ? str.tostring(qty, "#.###") + " u" : "—", text_color=color.white, bgcolor=bg)
    table.cell(tbl, 0, 8, "Note", text_color=color.new(color.gray,0), bgcolor=bg)
    table.cell(tbl, 1, 8, ok ? note : "Bias undefined", text_color=color.new(color.gray,0), bgcolor=bg)

// ---------------------------------------------------------------------
// ALERTS
// ---------------------------------------------------------------------
nearUp = not na(naAbove) and (naAbove - close) <= alertATR * atr and (naAbove - close) >= 0
nearDn = not na(naBelow) and (close - naBelow) <= alertATR * atr and (close - naBelow) >= 0
sweepUp = not na(naAbove) and high > naAbove and close < naAbove
sweepDn = not na(naBelow) and low  < naBelow and close > naBelow

alertcondition(nearUp,  "Approaching upper stop pool", "Price approaching buy-side stop pool (sweep likely)")
alertcondition(nearDn,  "Approaching lower stop pool", "Price approaching sell-side stop pool (sweep likely)")
alertcondition(sweepUp, "Upper stop pool swept", "Buy-side stop pool swept then rejected")
alertcondition(sweepDn, "Lower stop pool swept", "Sell-side stop pool swept then rejected")
